# URL du backend Node (backendMobile/) consommé par l'app mobile.
# En local, laisser ce fichier non copié en .env fait retomber l'app sur l'IP LAN de dev
# codée en dur dans constants/index.ts. Pour pointer vers un autre backend (prod, staging,
# ou une autre machine de dev), copier ce fichier en .env et renseigner les vraies valeurs.
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle JS au build — ne jamais y mettre
# de secret, uniquement des URLs publiques.

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.112:3001/api
EXPO_PUBLIC_STORAGE_URL=http://192.168.1.112:3001
